{
  "name": "picnic-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "./scripts/dev-server-manager.sh --start",
    "dev:clean": "./scripts/dev-server-manager.sh --clear-cache --start",
    "dev:stop": "./scripts/dev-server-manager.sh",
    "dev:3000": "./scripts/dev-server-manager.sh --port=3000 --start",
    "dev:3001": "./scripts/dev-server-manager.sh --port=3001 --start",
    "dev:4000": "./scripts/dev-server-manager.sh --port=4000 --start",
    "dev:help": "./scripts/dev-server-manager.sh --help",
    "dev:legacy": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; P=${PORT:-3100}; lsof -ti:$P | xargs kill -9 2>/dev/null || true && next dev --port $P'",
    "next-dev": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; next dev --turbopack --port ${PORT:-3100}'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "schema:types:sync": "sh scripts/sync-schema-types.sh",
    "gen:types": "npm run -s schema:types:sync",
    "postbuild": "next-sitemap && npm run sentry:release",
    "gen:thumbs": "tsx scripts/generate-video-thumbnails.ts",
    "sentry:release": "node scripts/sentry-release.js",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "audit:fix-force": "npm audit fix --force",
    "audit:report": "npm audit --audit-level=moderate",
    "security:check": "npm audit && echo '\\n✅ 보안 감사 완료. 위의 결과를 확인해주세요.'",
    "i18n:check": "tsx scripts/check-i18n-keys.ts",
    "i18n:fix": "tsx scripts/fix-i18n-keys.ts && npm run -s i18n:check",
    "i18n:auto": "tsx scripts/auto-translate.ts && npm run -s i18n:fix",
    "i18n:seed-en": "tsx scripts/seed-i18n-en.ts && npm run -s i18n:auto",
    "i18n:fill": "tsx scripts/fill-placeholders.ts && npm run -s i18n:check",
    "i18n:fix-dialog": "tsx scripts/fix-dialog-shortcuts.ts && npm run -s i18n:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@aws-sdk/s3-presigned-post": "^3.645.0",
    "@headlessui/react": "^2.2.2",
    "@heroicons/react": "^2.2.0",
    "@paypal/paypal-js": "^8.2.0",
    "@portone/server-sdk": "^0.17.0",
    "@sentry/nextjs": "^9.17.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^1.5.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "12.4.0",
    "framer-motion": "^12.15.0",
    "hls.js": "^1.6.15",
    "jose": "^6.2.9",
    "lodash.get": "^4.4.2",
    "lucide-react": "^0.508.0",
    "luxon": "^3.6.1",
    "next": "^15.5.26",
    "next-sitemap": "^4.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.0.5",
    "remark-gfm": "^4.0.1",
    "swr": "^2.3.4",
    "typescript": "^5.8.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@iamtraction/google-translate": "^2.0.1",
    "@sentry/cli": "^2.45.0",
    "@supabase/postgrest-js": "^2.112.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.6.2",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.14",
    "dotenv": "^16.5.0",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.1",
    "ffmpeg-static": "^5.2.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.3",
    "supabase": "^1.226.4",
    "tailwindcss": "^3.3.3",
    "tsx": "^4.19.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
